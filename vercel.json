{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "yarn build",
  "installCommand": "yarn install",
  "outputDirectory": "out",
  "redirects": [
    { "source": "/agent", "destination": "/agent.html", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode", "value": "agent" }],
      "destination": "/agent.html"
    },
    {
      "source": "/en",
      "has": [{ "type": "query", "key": "mode", "value": "agent" }],
      "destination": "/agent.html"
    },
    {
      "source": "/ja",
      "has": [{ "type": "query", "key": "mode", "value": "agent" }],
      "destination": "/agent.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": "text/markdown" }],
      "destination": "/index.md"
    },
    {
      "source": "/en",
      "has": [{ "type": "header", "key": "accept", "value": "text/markdown" }],
      "destination": "/en.md"
    },
    {
      "source": "/ja",
      "has": [{ "type": "header", "key": "accept", "value": "text/markdown" }],
      "destination": "/ja.md"
    },
    {
      "source": "/en/:path+",
      "has": [{ "type": "header", "key": "accept", "value": "text/markdown" }],
      "destination": "/en/:path+.md"
    },
    {
      "source": "/ja/:path+",
      "has": [{ "type": "header", "key": "accept", "value": "text/markdown" }],
      "destination": "/ja/:path+.md"
    }
  ],
  "headers": [
    {
      "source": "/llms(.*).txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        { "key": "Content-Type", "value": "application/linkset+json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/http-message-signatures-directory",
      "headers": [
        { "key": "Content-Type", "value": "application/http-message-signatures-directory+json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/(.*)\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.jsonl",
      "headers": [
        { "key": "Content-Type", "value": "application/jsonl; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/specs/(.*)\\.yaml",
      "headers": [
        { "key": "Content-Type", "value": "application/yaml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/specs/(.*)\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/openapi\\.yaml",
      "headers": [
        { "key": "Content-Type", "value": "application/yaml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/openapi\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/openapi\\.yaml",
      "headers": [
        { "key": "Content-Type", "value": "application/yaml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/openapi\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sitemap\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/schema-map\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/404\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/agent\\.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/site-index\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </openapi.yaml>; rel=\"service-desc\"; type=\"application/yaml\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    }
  ]
}
