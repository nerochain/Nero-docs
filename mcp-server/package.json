{
  "name": "@nerochain/docs-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for NERO Chain documentation. Search, fetch pages, look up Paymaster API methods.",
  "type": "module",
  "license": "MIT",
  "author": "NERO Chain <contact@nerochain.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerochain/Nero-docs",
    "directory": "mcp-server"
  },
  "keywords": [
    "mcp",
    "nero",
    "nerochain",
    "documentation",
    "account-abstraction",
    "paymaster"
  ],
  "main": "dist/index.js",
  "bin": {
    "nero-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-index.mjs",
    "build:index": "node scripts/build-index.mjs",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/index.js",
    "test:conformance": "node dist/eval/conformance.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.2",
    "minisearch": "^7.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11.1"
  }
}
